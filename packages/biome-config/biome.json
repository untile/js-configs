{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "jsxQuoteStyle": "single",
      "quoteStyle": "single",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "domains": {
      "drizzle": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "error"
      },
      "complexity": {
        "noArguments": "error",
        "noBannedTypes": "error",
        "noCommaOperator": "error",
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveNestedTestSuites": "error",
        "noRedundantDefaultExport": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUselessCatchBinding": "error",
        "noUselessConstructor": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefined": "error",
        "noUselessUndefinedInitialization": "error",
        "useArrayFind": "error",
        "useArraySome": "error",
        "useArrowFunction": "error",
        "useLiteralKeys": "error",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        },
        "useRegexpTest": "error",
        "useWhile": "error"
      },
      "correctness": {
        "noNestedComponentDefinitions": "error",
        "noReactPropAssignments": "error",
        "noUnusedImports": {
          "fix": "safe",
          "level": "error"
        },
        "noUnusedInstantiation": "error",
        "noUnusedVariables": {
          "fix": "none",
          "level": "error"
        },
        "useParseIntRadix": "error"
      },
      "nursery": {
        "noBooleanSortComparator": "error",
        "noConstantComparisons": "error",
        "noDuplicateMapKeys": "error",
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noInvalidRemoveEventListener": "error",
        "noMismatchedMapKey": "error",
        "noMissingThrow": "error",
        "noMisusedPromises": "error",
        "noObjectLiteralComparison": "error",
        "noReturnInFinally": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUselessAssignment": "error",
        "noXorAsExponentiation": "error",
        "useAwaitThenable": "error",
        "usePromiseRejectErrors": "error",
        "useTailwindSortedClasses": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "error",
        "noBarrelFile": "warn",
        "useTopLevelRegex": "error"
      },
      "security": {
        "noSecrets": {
          "level": "error",
          "options": {
            "entropyThreshold": 55
          }
        },
        "useIframeSandbox": "error"
      },
      "style": {
        "noImplicitBoolean": "error",
        "noInferrableTypes": "error",
        "noJsxLiterals": {
          "level": "error",
          "options": {
            "allowedStrings": [
              "—",
              "–",
              "−",
              "·",
              "•",
              "…",
              "...",
              "*",
              ":",
              "/",
              "|",
              "(",
              ")",
              "%",
              "-",
              "+",
              ".",
              ",",
              "#",
              "→",
              "←",
              "›",
              "‹",
              "×"
            ]
          }
        },
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "off",
        "noParameterAssign": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentObjectDefinitions": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useEnumInitializers": "error",
        "useExplicitLengthCheck": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true,
            "strictCase": true
          }
        },
        "useForOf": "error",
        "useFragmentSyntax": "error",
        "useGroupedAccessorPairs": "error",
        "useImportsFirst": "error",
        "useNumberNamespace": "error",
        "useObjectSpread": "error",
        "useReactFunctionComponents": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useTemplate": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noBitwiseOperators": "error",
        "noConfusingLabels": "error",
        "noConsole": "error",
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noDuplicateDependencies": "error",
        "noDuplicateEnumValues": "error",
        "noDuplicateSelectors": "error",
        "noEmptyBlockStatements": "error",
        "noEmptyObjectKeys": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noImportCycles": "warn",
        "noLoopFunc": "error",
        "noNestedPromises": "error",
        "noOctalEscape": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noProto": "error",
        "noPrototypeBuiltins": "error",
        "noReactForwardRef": "error",
        "noReturnAssign": "error",
        "noShadow": "error",
        "noSkippedTests": "warn",
        "noTsIgnore": "error",
        "noUnassignedVariables": "error",
        "noUnknownAttribute": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error"
      }
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
        "**/{test,tests,__tests__,e2e}/**",
        "**/*.stories.{js,jsx,ts,tsx}",
        "**/.storybook/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveNestedCallbacks": "off"
          },
          "correctness": {
            "noComponentHookFactories": "off",
            "noUnusedFunctionParameters": "off"
          },
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "noJsxLiterals": "off",
            "useImportsFirst": "off",
            "useThrowOnlyError": "off"
          },
          "suspicious": {
            "noAlert": "off",
            "noConsole": "off",
            "noReturnAssign": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/migrations/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/shadcn/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "nursery": {
            "useTailwindSortedClasses": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "noJsxLiterals": "off"
          }
        }
      }
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off",
            "useSortedPackageJson": "on"
          }
        }
      },
      "includes": ["**/package.json"]
    },
    {
      "formatter": {
        "enabled": false
      },
      "includes": ["**/CHANGELOG.md"]
    }
  ],
  "plugins": [
    {
      "path": "./plugins/no-lodash-root-import.grit",
      "resolutionKind": "config"
    }
  ],
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
